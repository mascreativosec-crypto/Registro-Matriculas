<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registro de Estudiantes - Eureka Education</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
    font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
    background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
    min-height:100vh;
    padding:20px
}
.container{
    max-width:900px;
    margin:auto;
    background:#fff;
    border-radius:15px;
    box-shadow:0 20px 60px rgba(0,0,0,.3);
    overflow:hidden
}
.header{
    background:linear-gradient(135deg,#003d5c 0%,#005a82 100%);
    color:#fff;
    padding:30px;
    text-align:center
}
.header h1{font-size:32px}
.subtitle{font-size:18px;margin:10px 0}
.form-container{padding:40px}
.section{margin-bottom:40px}
.section-title{
    font-size:20px;
    color:#003d5c;
    border-bottom:2px solid #667eea;
    margin-bottom:20px;
    padding-bottom:10px;
    display:flex;
    gap:10px
}
.form-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px
}
.form-group{display:flex;flex-direction:column}
.form-group.full-width{grid-column:1/-1}
label{font-weight:600;font-size:14px;margin-bottom:6px}
.required{color:#e74c3c}
input,select{
    padding:12px;
    border:2px solid #e0e0e0;
    border-radius:8px;
    font-size:14px
}
input:focus,select:focus{
    outline:none;
    border-color:#667eea
}
.beneficiario-item{
    background:#f8f9fa;
    padding:20px;
    border-radius:8px;
    margin-bottom:15px
}
.beneficiario-header{
    font-weight:600;
    color:#667eea;
    margin-bottom:10px
}
.radio-group{display:flex;gap:20px;margin-top:5px}
.btn-container{text-align:center;margin-top:30px}
button{
    padding:14px 40px;
    border:none;
    border-radius:8px;
    font-weight:600;
    cursor:pointer
}
.btn-primary{
    background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
    color:#fff
}
.btn-secondary{background:#e0e0e0}
.alert{padding:15px;border-radius:8px;margin-bottom:20px;display:none}
.alert-success{background:#d4edda;color:#155724}
.alert-error{background:#f8d7da;color:#721c24}
.loading{text-align:center;display:none}
.spinner{
    width:40px;height:40px;
    border:4px solid #eee;
    border-top:4px solid #667eea;
    border-radius:50%;
    animation:spin 1s linear infinite;
    margin:auto
}
@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:768px){
    .form-container{padding:20px}
}
</style>
</head>

<body>
<div class="container">
<div class="header">
    <h1>Eureka! Education</h1>
    <p class="subtitle">🎓 Registro de Nuevos Estudiantes</p>
    <p>Registro oficial de contratos académicos</p>
</div>

<div class="form-container">

<div id="alertSuccess" class="alert alert-success"></div>
<div id="alertError" class="alert alert-error"></div>

<div id="loading" class="loading">
    <div class="spinner"></div>
    <p>Procesando información...</p>
</div>

<form id="registroForm">

<!-- CONTRATO -->
<div class="section">
<div class="section-title">📋 Información del Contrato</div>
<div class="form-grid">
<input name="numeroContrato" placeholder="N° Contrato" required>
<input type="date" name="fechaContrato" required>
</div>
</div>

<!-- TITULAR -->
<div class="section">
<div class="section-title">👤 Datos del Titular</div>
<div class="form-grid">
<input name="nombreTitular" placeholder="Nombre completo" required>
<input name="cedulaTitular" placeholder="Cédula o RUC" required>
<input name="telefonoTitular" placeholder="Teléfono" required>
<input type="email" name="correoElectronico" placeholder="Correo" required>
<input class="full-width" name="direccion" placeholder="Dirección">
</div>
</div>

<!-- BENEFICIARIO 1 -->
<div class="section">
<div class="section-title">👥 Beneficiarios</div>

<div class="beneficiario-item">
<div class="beneficiario-header">Beneficiario 1</div>
<div class="form-grid">
<input name="nombreBeneficiario1" placeholder="Nombre" required>
<input name="cedulaBeneficiario1" placeholder="Cédula" required>
<input type="number" name="edadBeneficiario1" placeholder="Edad" required>
<input name="telefonoBeneficiario1" placeholder="Teléfono">
<input type="email" class="full-width" name="correoBeneficiario1" placeholder="Correo">
</div>
</div>

<input type="number" name="numeroPersonas" placeholder="N° Beneficiarios" min="1" max="3" required>
</div>

<!-- PROGRAMA -->
<div class="section">
<div class="section-title">📚 Programa Académico</div>
<div class="form-grid">
<select name="tipoPrograma" required>
<option value="">Programa</option>
<option>A1</option><option>A2</option><option>B1</option><option>B2</option><option>C1</option>
<option>PC</option>
<option>PROGRAMA I</option>
<option>PROGRAMA II</option>
<option>PROGRAMA III</option>
<option>KIDS PROGRAM</option>
</select>

<select name="modalidad" required>
<option value="">Modalidad</option>
<option>PRESENCIAL</option>
<option>ONLINE</option>
<option>HÍBRIDO</option>
</select>

<input type="date" name="fechaInicioTutorias" required>
<input type="number" name="tiempoTutorias" placeholder="Meses" required>
</div>
</div>

<!-- PAGOS -->
<div class="section">
<div class="section-title">💰 Pagos</div>
<div class="form-grid">

<select name="formaPago" required>
<option value="">Forma de pago</option>
<option>CONTADO</option>
<option>CRÉDITO</option>
</select>

<input type="number" name="fechaCorte" placeholder="Día corte" required>
<input type="date" name="primerPago" required>

<input type="number" id="precioTotal" name="precioTotal" placeholder="Precio Total" required>
<input type="number" id="matriculaInicial" name="matriculaInicial" value="0">

<input type="number" id="saldo" name="saldo" readonly placeholder="Saldo">
<input type="number" id="numeroMensualidades" name="numeroMensualidades" required>
<input type="number" id="valorMensual" name="valorMensual" readonly placeholder="Valor mensual">

</div>
</div>

<div class="btn-container">
<button type="reset" class="btn-secondary">Limpiar</button>
<button type="submit" class="btn-primary">Registrar</button>
</div>

</form>
</div>
</div>

<script>
const WEBHOOK_URL = "https://TU_WEBHOOK_N8N_AQUI";

const precio = document.getElementById("precioTotal");
const matricula = document.getElementById("matriculaInicial");
const saldo = document.getElementById("saldo");
const cuotas = document.getElementById("numeroMensualidades");
const valor = document.getElementById("valorMensual");

function calcular(){
    saldo.value = ((precio.value||0)-(matricula.value||0)).toFixed(2);
    valor.value = cuotas.value ? (saldo.value/cuotas.value).toFixed(2) : "";
}

precio.oninput = matricula.oninput = cuotas.oninput = calcular;

document.getElementById("registroForm").onsubmit = async e=>{
e.preventDefault();
document.getElementById("loading").style.display="block";

const data = Object.fromEntries(new FormData(e.target));

try{
await fetch(WEBHOOK_URL,{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify(data)
});
document.getElementById("alertSuccess").innerText="✅ Registro enviado correctamente";
document.getElementById("alertSuccess").style.display="block";
}catch(err){
document.getElementById("alertError").innerText="❌ Error al enviar datos";
document.getElementById("alertError").style.display="block";
}

document.getElementById("loading").style.display="none";
}
</script>
</body>
</html>
